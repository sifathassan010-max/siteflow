# Copy to .env.local (locally) or set these in Vercel's Environment Variables
# (Settings -> Environment Variables) for the deployed site. Never commit real values.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Grok API (already have) ---
GROK_API_KEY=

# --- Patreon (step 3) ---
PATREON_CLIENT_ID=
PATREON_CLIENT_SECRET=
PATREON_WEBHOOK_SECRET=

# --- Site URL (step 5, sitemap.xml / robots.txt) ---
# Set this once a real custom domain is connected. Until then, sitemap.xml
# and robots.txt fall back to the live siteflow-omega.vercel.app URL on
# their own, so this is optional for now.
NEXT_PUBLIC_SITE_URL=
